{
  "name": "wod-wiki",
  "version": "0.6.0",
  "private": true,
  "description": "The wod.wiki playground app — workout journal, canvas editor, review surfaces, and Chromecast receiver built on the Whiteboard Language packages (@bitcobblers/wod-wiki-engine, @bitcobblers/wod-wiki-ui) published from the wod-wiki-engine repository.",
  "homepage": "https://github.com/SergeiGolos/wod-wiki#readme",
  "bugs": {
    "url": "https://github.com/SergeiGolos/wod-wiki/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SergeiGolos/wod-wiki.git"
  },
  "scripts": {
    "postinstall": "node scripts/fix-codemirror-deps.cjs",
    "wod": "wod",
    "setup": "bun setup-testing.js",
    "generate:static-index": "bun run scripts/generate-static-block-index.ts",
    "test": "bun tests/run-isolated.ts ./src ./playground/src --preload ./tests/unit-setup.ts",
    "test:components": "bun test tests --path-ignore-patterns='tests/wods/all-wods.test.ts' --path-ignore-patterns='tests/canvas/syntax-source-markdown.test.ts' --preload ./tests/setup.ts",
    "test:markdown": "bun test tests/wods/all-wods.test.ts tests/canvas/syntax-source-markdown.test.ts --preload ./tests/setup.ts",
    "test:all": "bun run test && bun run test:components",
    "test:coverage": "bun tests/run-isolated.ts ./src --preload ./tests/unit-setup.ts",
    "test:glob": "bunx vitest run --config vitest.glob.config.ts",
    "test:perf": "bun test tests/performance",
    "test:e2e": "bun x playwright test --config playwright.journal.config.ts",
    "build:app": "bun x vite build --config playground/vite.config.ts && bun run scripts/generate-static-shells.ts",
    "preview:app": "node node_modules/vite/bin/vite.js preview --config playground/vite.config.ts",
    "playground": "node node_modules/vite/bin/vite.js --config playground/vite.config.ts",
    "analyze:deps": "bun x madge --extensions ts,tsx --ts-config tsconfig.json --exclude __tests__ --circular src/",
    "check:architecture-regressions": "node scripts/check-architecture-regressions.cjs",
    "check:unused-exports": "node scripts/check-unused-exports-regressions.cjs",
    "check:architecture": "bun run check:architecture-regressions && bun run check:unused-exports",
    "docs:check": "bun scripts/check-docs-links.cjs",
    "dev": "bun scripts/dev-start.cjs",
    "dev:web": "bun scripts/dev-start.cjs --web-only --no-emulator",
    "dev:all": "bun scripts/dev-start.cjs",
    "dev:app": "node node_modules/vite/bin/vite.js --config playground/vite.config.ts",
    "deps:engine": "bun scripts/use-engine.ts",
    "deps:engine:npm": "bun scripts/use-engine.ts npm",
    "deps:engine:link": "bun scripts/use-engine.ts link",
    "deps:engine:tarballs": "bun scripts/use-engine.ts tarballs"
  },
  "dependencies": {
    "@bitcobblers/wod-wiki-core": "^0.6.36",
    "@bitcobblers/wod-wiki-engine": "^0.6.36",
    "@bitcobblers/wod-wiki-lang": "^0.6.36",
    "@bitcobblers/wod-wiki-ui": "^0.6.36",
    "@bitcobblers/wod-wiki-wql": "^0.6.36",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "1.16.0",
    "motion": "^12.43.0",
    "nuqs": "^2.10.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "peerDependenciesMeta": {},
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.62.5"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "bun-types": "^1.4.0",
    "concurrently": "^9.2.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.0",
    "eslint-plugin-storybook": "10.5.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.33.0",
    "madge": "^8.0.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup": "^4.62.5",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "ts-morph": "^28.0.0",
    "ts-prune": "^0.10.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@codemirror/language": "^6.12.4",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "@lezer/markdown": "^1.6.3"
  },
  "allowScripts": {}
}
