# wod.wiki environment example.
#
# Two separate consumers read environment config:
#   1. Vite (playground/storybook builds + dev server) reads VITE_* from this
#      file (envDir = repo root).
#   2. The Bun API server (apps/api) reads plain non-VITE_* vars from the
#      process environment — export them or put them in your shell; docker
#      compose passes .env through automatically. `bun playground` / `bun
#      build:app` pin VITE_STORAGE=indexed-db so server-mode env vars in this
#      file cannot switch the ordinary playground away from IndexedDB.

# ── Vite (frontend builds) ──────────────────────────────────────────────────
# Storage backend selector for custom vite invocations: `api` persists through
# the HTTP ApiStorage backend, anything else keeps IndexedDB. The two shipped
# builds pin this themselves (dist → indexed-db, dist-api → api).
# VITE_STORAGE=indexed-db
# API base URL for the api storage backend. A relative '/api' is the default
# and works same-origin behind `bun server` and the vite dev proxy.
VITE_API_URL=/api

# Google Analytics (optional)
# G_TAG=your-google-analytics-id

# HTTPS / TLS for the dev server (optional — Chromecast requires it).
# Leave unset to run over plain HTTP (default). Auto-detected *.ts.net certs
# in the repo root enable it; set VITE_NO_HTTPS=1 to disable the auto-detect.

# ── Server (apps/api: `bun server`, `bun start:server`, docker compose) ────
PORT=3000
HOST=127.0.0.1
# Storage driver: sqlite (default) | turso | postgres.
DB_DRIVER=sqlite
# Defaults: repo-root ./data/wodwiki.db locally, /data/wodwiki.db in Docker.
# Override only when the chosen path is writable and persistent.
# SQLITE_PATH=./data/wodwiki.db
# Remote libsql:// or https:// URL for turso/sqlite drivers (optional).
# DATABASE_URL=libsql://your-db.turso.io
# Auth token for the remote database (optional).
# LIBSQL_AUTH_TOKEN=
# postgres:// or postgresql:// URL — REQUIRED when DB_DRIVER=postgres.
# DATABASE_URL=postgres://user:password@localhost:5432/wodwiki
# Built SPA directory (repo-root relative). Defaults to apps/playground/dist-api.
# PLAYGROUND_DIST=
