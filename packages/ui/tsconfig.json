{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../src/*"],
      "@bitcobblers/wod-wiki-engine": ["../engine/src/index.ts"],
      "@bitcobblers/wod-wiki-ui": ["./src/index.ts"],
      "@bitcobblers/wod-wiki-ui/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx"
  ]
}
