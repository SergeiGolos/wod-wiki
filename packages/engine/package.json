{
  "name": "@wod-wiki/engine",
  "version": "0.1.0",
  "description": "Umbrella package for Whiteboard Language & WQL engine with CLI runner",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "wod": "./dist/bin/wod.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@wod-wiki/core": "workspace:*",
    "@wod-wiki/lang": "workspace:*",
    "@wod-wiki/wql": "workspace:*"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
